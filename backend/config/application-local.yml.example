# 复制为 backend/config/application-local.yml 后生效（该文件已被 .gitignore 忽略）。
# 启动命令：./mvnw spring-boot:run -Dspring-boot.run.profiles=local
#
# 默认使用 docker-compose.yml 暴露的 5433 端口。
# 如果直接用宿主机已安装的 PostgreSQL（例如本机 5432 上的 yingyou 库），把端口改成 5432。
# 密码从环境变量 DB_PASSWORD 读取，避免把凭据提交进仓库。
spring:
  datasource:
    url: jdbc:postgresql://localhost:5433/yingyou
    username: yingyou
    password: ${DB_PASSWORD}
